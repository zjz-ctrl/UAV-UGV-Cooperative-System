    </model>

    <model name='obs_gate_cyan'>
      <static>1</static>
      <pose>0 5 0 0 0 0</pose>

      <link name='left'>
        <pose>-0.8 0 1 0 0 0</pose>
        <collision name='col'><geometry><box><size>0.25 0.25 2.0</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.25 0.25 2.0</size></box></geometry>
