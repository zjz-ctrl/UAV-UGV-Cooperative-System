      <link name='top'>
        <pose>0 0 2.1 0 0 0</pose>
        <collision name='col'><geometry><box><size>2.0 0.25 0.25</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>2.0 0.25 0.25</size></box></geometry>
          <material><ambient>0.2 0.9 1 1</ambient><diffuse>0.2 0.9 1 1</diffuse></material>
        </visual>
