    <!-- 高塔 -->
    <model name='tower_purple'>
      <static>1</static>
      <pose>5 -5 5 0 0 0</pose>
      <link name='link'>
        <collision name='collision'><geometry><box><size>0.6 0.6 10</size></box></geometry></collision>
