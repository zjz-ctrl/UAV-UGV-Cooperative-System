            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 你这里仍保留了圆柱/球体/坡道等：用于深度/规划测试也有价值 -->
    <model name='obs_cyl_green'>
      <static>1</static>
      <pose>-2 2 0.6 0 0 0</pose>
      <link name='link'>
        <collision name='col'><geometry><cylinder><radius>0.35</radius><length>1.2</length></cylinder></geometry></collision>
        <visual name='vis'>
