    <model name='obs_panel_purple'>
      <static>1</static>
      <pose>4 0 1 0 0 0.6</pose>
      <link name='link'>
        <collision name='col'><geometry><box><size>0.15 3.0 2.0</size></box></geometry></collision>
        <visual name='vis'>
          <geometry><box><size>0.15 3.0 2.0</size></box></geometry>
          <material>
