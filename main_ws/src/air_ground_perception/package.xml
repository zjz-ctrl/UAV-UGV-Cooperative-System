<?xml version="1.0"?>
<package format="2">
  <name>air_ground_perception</name>
  <version>0.1.0</version>
  <description>Image-only ChArUco and RGB-D target perception for air-ground cooperation.</description>
  <maintainer email="maintainer@example.com">air_ground_cooperation</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>cv_bridge</build_depend><build_depend>geometry_msgs</build_depend>
  <build_depend>rospy</build_depend><build_depend>sensor_msgs</build_depend>
  <build_depend>std_msgs</build_depend><build_depend>visualization_msgs</build_depend>
  <build_export_depend>cv_bridge</build_export_depend><build_export_depend>geometry_msgs</build_export_depend>
  <build_export_depend>rospy</build_export_depend><build_export_depend>sensor_msgs</build_export_depend>
  <build_export_depend>std_msgs</build_export_depend><build_export_depend>visualization_msgs</build_export_depend>
  <exec_depend>cv_bridge</exec_depend><exec_depend>geometry_msgs</exec_depend>
  <exec_depend>rospy</exec_depend><exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend><exec_depend>visualization_msgs</exec_depend>
</package>
