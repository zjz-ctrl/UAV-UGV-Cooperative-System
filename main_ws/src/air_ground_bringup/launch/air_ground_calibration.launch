<launch>
  <arg name="gui" default="true"/>
  <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/empty.world"/>
  <include file="$(find air_ground_bringup)/launch/mvp_system.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="start_ego" value="false"/>
    <arg name="start_cxr" value="false"/>
    <arg name="auto_takeoff" value="false"/>
    <arg name="start_coordinate_transform" value="true"/>
    <arg name="start_world_boundaries" value="false"/>
    <arg name="start_rviz" value="false"/>
  </include>
  <include file="$(find air_ground_perception)/launch/perception.launch"/>
</launch>
