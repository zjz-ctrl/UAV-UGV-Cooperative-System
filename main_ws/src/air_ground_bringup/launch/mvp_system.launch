<launch>
  <arg name="gui" default="true"/>
  <arg name="start_ego" default="true"/>
  <arg name="start_cxr" default="true"/>
  <arg name="cxr_launch_prefix" default=""/>
  <arg name="start_coordinate_transform" default="true"/>
  <arg name="start_world_boundaries" default="true"/>
  <arg name="start_rviz" default="true"/>
  <arg name="auto_takeoff" default="true"/>
  <arg name="uav_depth_topic" default="/iris_0/realsense/depth_camera/depth/image_raw"/>
  <arg name="uav_x" default="-6.0"/>
  <arg name="uav_y" default="0.0"/>
  <arg name="uav_yaw" default="0.0"/>
  <arg name="ugv_x" default="-5.3"/>
  <arg name="ugv_y" default="0.0"/>
  <arg name="ugv_yaw" default="0.0"/>
  <arg name="use_visual_frame_yaw" default="true"/>
  <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/ego.world"/>
  <arg name="spawn_red_sphere" default="true"/>
  <arg name="red_sphere_x" default="2.0"/>
  <arg name="red_sphere_y" default="0.0"/>
  <arg name="red_sphere_z" default="0.25"/>

  <param name="use_sim_time" value="true"/>

  <include file="$(find air_ground_bringup)/launch/uav_sitl.launch">
    <arg name="gui" value="$(arg gui)"/>
    <arg name="world" value="$(arg world)"/>
    <arg name="x" value="$(arg uav_x)"/>
    <arg name="y" value="$(arg uav_y)"/>
    <arg name="yaw" value="$(arg uav_yaw)"/>
  </include>

  <include file="$(find air_ground_ugv_gazebo)/launch/spawn_ugv.launch">
    <arg name="x" value="$(arg ugv_x)"/>
    <arg name="y" value="$(arg ugv_y)"/>
    <arg name="yaw" value="$(arg ugv_yaw)"/>
  </include>

  <node if="$(arg spawn_red_sphere)" pkg="gazebo_ros" type="spawn_model" name="spawn_red_sphere" output="screen"
        args="-sdf -file $(find air_ground_ugv_gazebo)/models/red_sphere/model.sdf -model red_sphere -x $(arg red_sphere_x) -y $(arg red_sphere_y) -z $(arg red_sphere_z)"/>

  <group ns="iris_0" if="$(arg start_ego)">
    <include file="$(find ego_planner)/launch/single_run_in_gazebo.launch">
      <arg name="odom_topic" value="mavros/local_position/odom"/>
      <arg name="depth_topic" value="$(arg uav_depth_topic)"/>
      <arg name="cmd_topic" value="position_cmd"/>
      <arg name="trajectory_topic" value="planning/trajectory"/>
      <arg name="heartbeat_topic" value="traj_server/heartbeat"/>
    </include>
  </group>

  <group ns="iris_0" if="$(arg start_cxr)">
    <node pkg="cxr_egoctrl_v1" type="cxr_egoctrl_v1" name="cxr_egoctrl"
          output="screen" launch-prefix="$(arg cxr_launch_prefix)"/>
    <node if="$(arg auto_takeoff)" pkg="air_ground_bringup" type="auto_takeoff_trigger.py"
          name="auto_takeoff_trigger" output="screen"/>
  </group>

  <include if="$(arg start_coordinate_transform)"
           file="$(find air_ground_coordinate_transform)/launch/coordinate_transform.launch">
    <arg name="use_visual_frame_yaw" value="$(arg use_visual_frame_yaw)"/>
  </include>

  <node if="$(arg start_world_boundaries)" pkg="air_ground_bringup" type="world_boundary_visualizer.py"
        name="world_boundary_visualizer" output="screen">
    <rosparam command="load" file="$(find air_ground_bringup)/config/world_boundaries.yaml"/>
  </node>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="mvp_rviz"
        args="-d $(find air_ground_bringup)/rviz/mvp.rviz" output="screen"/>
</launch>
