<?xml version="1.0"?>
<sdf version="1.6">
  <model name="ugv_mvp">
    <static>false</static>
    <link name="base_link">
      <pose>0 0 0.16 0 0 0</pose>
      <inertial>
        <mass>8.0</mass>
        <inertia>
          <ixx>0.22</ixx><iyy>0.32</iyy><izz>0.42</izz>
          <ixy>0</ixy><ixz>0</ixz><iyz>0</iyz>
        </inertia>
      </inertial>
      <collision name="chassis_collision">
        <geometry><box><size>0.72 0.48 0.20</size></box></geometry>
      </collision>
      <visual name="chassis_visual">
        <geometry><box><size>0.72 0.48 0.20</size></box></geometry>
        <material><ambient>0.10 0.35 0.80 1</ambient><diffuse>0.10 0.35 0.80 1</diffuse></material>
      </visual>
    </link>

    <link name="rear_left_wheel">
      <pose>-0.25 0.28 0.12 -1.570796 0 0</pose>
      <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual>
    </link>
    <joint name="rear_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_left_wheel</child>
      <axis><xyz>0 1 0</xyz><use_parent_model_frame>1</use_parent_model_frame><limit><lower>-1000000</lower><upper>1000000</upper><effort>20</effort><velocity>30</velocity></limit></axis>
    </joint>

    <link name="rear_right_wheel">
      <pose>-0.25 -0.28 0.12 1.570796 0 0</pose>
      <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.06</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual>
    </link>
    <joint name="rear_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>rear_right_wheel</child>
      <axis><xyz>0 1 0</xyz><use_parent_model_frame>1</use_parent_model_frame><limit><lower>-1000000</lower><upper>1000000</upper><effort>20</effort><velocity>30</velocity></limit></axis>
    </joint>

    <link name="front_left_wheel">
      <pose>0.25 0.28 0.12 -1.570796 0 0</pose>
      <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual>
    </link>
    <joint name="front_left_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_left_wheel</child>
      <axis><xyz>0 1 0</xyz><use_parent_model_frame>1</use_parent_model_frame><limit><lower>-1000000</lower><upper>1000000</upper><effort>20</effort><velocity>30</velocity></limit></axis>
    </joint>

    <link name="front_right_wheel">
      <pose>0.25 -0.28 0.12 1.570796 0 0</pose>
      <inertial><mass>0.4</mass><inertia><ixx>0.002</ixx><iyy>0.002</iyy><izz>0.002</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry><surface><friction><ode><mu>1.2</mu><mu2>1.2</mu2></ode></friction></surface></collision>
      <visual name="visual"><geometry><cylinder><radius>0.12</radius><length>0.08</length></cylinder></geometry><material><ambient>0.05 0.05 0.05 1</ambient></material></visual>
    </link>
    <joint name="front_right_wheel_joint" type="revolute">
      <parent>base_link</parent><child>front_right_wheel</child>
      <axis><xyz>0 1 0</xyz><use_parent_model_frame>1</use_parent_model_frame><limit><lower>-1000000</lower><upper>1000000</upper><effort>20</effort><velocity>30</velocity></limit></axis>
    </joint>

    <link name="fiducial">
      <pose>0.18 0 0.42 0 0 0</pose>
      <visual name="marker">
        <geometry><box><size>0.02 0.28 0.28</size></box></geometry>
        <material><ambient>0.95 0.95 0.10 1</ambient><diffuse>0.95 0.95 0.10 1</diffuse></material>
      </visual>
    </link>
    <joint name="fiducial_joint" type="fixed"><parent>base_link</parent><child>fiducial</child></joint>

    <!-- A horizontal ChArUco board gives the nadir camera many sub-pixel corners. -->
    <link name="charuco_board">
      <pose>-0.05 0 0.275 0 0 0</pose>
      <visual name="backing">
        <pose>0 0 -0.005 0 0 0</pose>
        <geometry><box><size>0.565 0.415 0.01</size></box></geometry>
        <material><ambient>1 1 1 1</ambient><diffuse>1 1 1 1</diffuse><specular>0 0 0 1</specular></material>
      </visual>
      <visual name="charuco_texture">
        <geometry><mesh><uri>model://ugv_mvp/meshes/charuco_board.dae</uri></mesh></geometry>
        <material><script><uri>model://ugv_mvp/materials/scripts</uri><uri>model://ugv_mvp/materials/textures</uri><name>ugv_mvp/charuco_7x5</name></script></material>
      </visual>
    </link>
    <joint name="charuco_board_joint" type="fixed"><parent>base_link</parent><child>charuco_board</child></joint>

    <link name="camera_link">
      <pose>0.30 0 0.38 0 0 0</pose>
      <inertial><mass>0.02</mass><inertia><ixx>0.00001</ixx><iyy>0.00001</iyy><izz>0.00001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="camera_visual">
        <geometry><box><size>0.08 0.08 0.05</size></box></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient></material>
      </visual>
      <sensor name="front_camera" type="camera">
        <always_on>true</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.047198</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>20.0</far></clip>
        </camera>
        <plugin name="front_camera_ros" filename="libgazebo_ros_camera.so">
          <robotNamespace>/ugv_0</robotNamespace>
          <cameraName>camera</cameraName>
          <imageTopicName>image_raw</imageTopicName>
          <cameraInfoTopicName>camera_info</cameraInfoTopicName>
          <frameName>ugv_0/camera_link</frameName>
        </plugin>
      </sensor>
    </link>
    <joint name="camera_joint" type="fixed"><parent>base_link</parent><child>camera_link</child></joint>

    <!-- Planar velocity control keeps the lightweight demo platform stable. -->
    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <robotNamespace>/ugv_0</robotNamespace>
      <commandTopic>cmd_vel</commandTopic>
      <odometryTopic>odom</odometryTopic>
      <odometryFrame>ugv_0/odom</odometryFrame>
      <robotBaseFrame>ugv_0/base_link</robotBaseFrame>
      <odometryRate>50</odometryRate>
      <cmdTimeout>0.25</cmdTimeout>
    </plugin>

    <plugin name="relative_pose_sensor" filename="librelative_pose_sensor_plugin.so">
      <camera_model_name>iris_0</camera_model_name>
      <camera_link_name>D435i::link</camera_link_name>
      <marker_link_name>fiducial</marker_link_name>
      <camera_frame>iris_0/camera_link</camera_frame>
      <observation_topic>/iris_0/ugv_observation</observation_topic>
      <update_rate>15.0</update_rate>
      <max_distance>8.0</max_distance>
      <horizontal_fov>1.047198</horizontal_fov>
      <vertical_fov>0.785398</vertical_fov>
      <position_stddev>0.0</position_stddev>
      <orientation_stddev>0.0</orientation_stddev>
    </plugin>
  </model>
</sdf>
